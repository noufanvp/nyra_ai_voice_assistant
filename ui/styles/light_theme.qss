/*
 * light_theme.qss — Clean Daylight QSS Stylesheet for Nyra AI Voice Assistant.
 *
 * Palette:
 *   Background      #F0F4F8 (soft off-white)
 *   Surface Glass   rgba(255, 255, 255, 0.92)
 *   Surface Alt     #E2E8F0
 *   Accent Indigo   #4F46E5
 *   Accent Cyan     #0891B2
 *   Accent Purple   #9333EA
 *   Text Primary    #0F172A
 *   Text Muted      #64748B
 */

/* ── Root Window & Dialogs ───────────────────────────────────────────── */

QMainWindow, QDialog {
    background-color: #F0F4F8;
    color: #0F172A;
}

QWidget {
    background-color: transparent;
    color: #0F172A;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* ── Scroll Areas & Scrollbars ───────────────────────────────────────── */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: rgba(203, 213, 225, 0.5);
    width: 6px;
    margin: 4px 2px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #94A3B8, stop:1 #CBD5E1);
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4F46E5, stop:1 #9333EA);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: rgba(203, 213, 225, 0.5);
    height: 6px;
    margin: 2px 4px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: #94A3B8;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #4F46E5;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── Standard Buttons ────────────────────────────────────────────────── */

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4F46E5, stop:1 #6366F1);
    color: #FFFFFF;
    border: 1px solid rgba(99, 102, 241, 0.4);
    border-radius: 10px;
    padding: 9px 20px;
    font-weight: 600;
    font-size: 13px;
    outline: none;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6366F1, stop:1 #818CF8);
    border-color: rgba(168, 85, 247, 0.6);
}

QPushButton:pressed {
    background-color: #3730A3;
}

QPushButton:disabled {
    background-color: #E2E8F0;
    color: #94A3B8;
    border-color: transparent;
}

QPushButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4F46E5, stop:1 #7C3AED);
    border: 1px solid #9333EA;
}

/* ── ComboBox ───────────────────────────────────────────────────────── */

QComboBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid rgba(148, 163, 184, 0.6);
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
}

QComboBox:hover {
    border-color: #4F46E5;
}

QComboBox:focus {
    border-color: #0891B2;
    outline: none;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #64748B;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid rgba(148, 163, 184, 0.5);
    border-radius: 8px;
    selection-background-color: #EEF2FF;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 7px 12px;
    border-radius: 5px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #F1F5F9;
}

/* ── Typography & Labels ─────────────────────────────────────────────── */

QLabel {
    color: #0F172A;
    background-color: transparent;
}

QLabel#lbl_title {
    font-size: 15px;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: 0.6px;
}

QLabel#lbl_subtitle {
    font-size: 11px;
    color: #64748B;
    letter-spacing: 0.3px;
}

QLabel#lbl_section {
    font-size: 10px;
    font-weight: 800;
    color: #0891B2;
    letter-spacing: 1.6px;
    text-transform: uppercase;
}

QLabel#lbl_telemetry_value {
    font-family: "JetBrains Mono", "Fira Code", "Courier New", monospace;
    font-size: 12px;
    color: #059669;
}

/* ── Panel Surfaces & Glass Containers ──────────────────────────────── */

QFrame#panel_surface {
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 16px;
    border: 1px solid rgba(148, 163, 184, 0.25);
}

QFrame#panel_settings {
    background-color: rgba(248, 250, 252, 0.98);
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
}

QFrame#title_bar {
    background-color: #F8FAFC;
    border-bottom: 1px solid rgba(148, 163, 184, 0.25);
}

/* ── Tooltips ───────────────────────────────────────────────────────── */

QToolTip {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid rgba(148, 163, 184, 0.4);
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 12px;
}
